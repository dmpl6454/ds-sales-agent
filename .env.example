# ─────────────────────────────────────────────────────────────────────────────
# DS AI Sales Agent — Phase 1
#
# Copy to `.env` and adjust. Phase 1 needs NO external API keys.
# Instagram passwords are never stored here — see `pnpm session:add`.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite file. Path is relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# ── SAFETY ───────────────────────────────────────────────────────────────────
# 1 = run the full pipeline (detect, classify, plan) but SEND NOTHING and mark
#     nothing READY. Use this for the first week to audit exactly what would
#     have gone out. This is the default; you must consciously turn it off.
DRY_RUN=1

# Comma-separated IST slot times the worker fires at.
SLOTS="11:00,15:00,17:00,20:00"
TZ="Asia/Kolkata"

# If a slot was missed while the machine was off, run it on boot when the miss
# is younger than this many minutes. Prevents silent skips without replaying
# stale slots from days ago.
CATCHUP_WINDOW_MINUTES=240

# ── OUTREACH GOVERNOR ────────────────────────────────────────────────────────
# Defaults; overridable per-pair in the DB and editable in /settings.
DEFAULT_COOLDOWN_DAYS=7
MAX_PER_TARGET_PER_DAY=1
# Only use a detected campaign as a hook if it is fresher than this.
HOOK_MAX_AGE_HOURS=72

# ── SENDING (autopilot) ──────────────────────────────────────────────────────
# Human-like delay bounds between consecutive DMs, in seconds.
SEND_JITTER_MIN_SECONDS=45
SEND_JITTER_MAX_SECONDS=180
# Set true only after you have watched manual mode behave. Per-sender override
# lives on SenderAccount.autoSendEnabled — this is a global kill switch.
AUTOPILOT_ENABLED=false

# ── DASHBOARD ────────────────────────────────────────────────────────────────
# Fallback name recorded by the CLI ONLY, as "cli:<name>".
#
# The dashboard no longer uses this: it records the SIGNED-IN USER's email, because
# registration is open and one shared string would make the audit trail on three
# revenue accounts say the same thing no matter who pressed the button. The CLI has no
# session to read, so it keeps this — prefixed, so "pressed Send on the dashboard" and
# "typed y in a terminal" stay distinguishable in `sentBy`.
OPERATOR_NAME="Tabish"

# Set to 1 ONLY when the dashboard is served over HTTPS (a tunnel, or a hosted
# deployment). It marks the session cookie `secure`, and a secure cookie is not sent
# over plain HTTP — so setting it while running on http://127.0.0.1:3000 makes sign-in
# appear to succeed and then silently not work.
COOKIE_SECURE=0

# ── WHICH BROWSER `pnpm send` OPENS ──────────────────────────────────────────
# Must be the browser you are logged into the sending accounts in. Leave empty to
# use the macOS default https handler — but note the default is often Safari even
# when your Instagram session lives in Chrome, and the symptom is a login wall
# that looks like the agent lost your session. It never had one: the agent stores
# no Instagram credentials at all.
#
#   SEND_BROWSER="Google Chrome"   SEND_BROWSER="Brave Browser"   SEND_BROWSER="Safari"
SEND_BROWSER=""

# ── THE SCHEDULER ────────────────────────────────────────────────────────────
# The dashboard runs the watch in its own process, so starting the app is enough
# for slots to fire. Set false only when you run `pnpm worker` separately (a
# server). Whichever starts second sees the other's heartbeat and declines.
EMBEDDED_SCHEDULER=true

# ── READING THE TEXT IN A POST'S VIDEO ───────────────────────────────────────
# NOTHING TO CONFIGURE, AND NO API KEY. A paid placement can live entirely in the
# footage (the Thane bus, CLAUDE.md "THE CAPTION IS NOT THE POST"), and the
# decisive evidence there was TEXT on screen. That is read locally by Apple's
# Vision framework - offline, ~0.2s a frame, no network, no cost. Frames are
# saved to ~/.ds-sales-agent/frames. On Windows, install tesseract for a
# (measurably worse) fallback; without either, the dashboard SAYS frames are not
# being read rather than reporting clean footage.
