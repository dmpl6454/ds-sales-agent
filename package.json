  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "next": "^16.2.12",
    "node-cron": "^4.6.0",
    "patchright": "^1.61.1",
    "pg": "^8.22.0",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
