{
  "name": "ds-sales-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "run:slot": "tsx src/worker/runOnce.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "reclassify": "tsx src/scripts/reclassify.ts",
    "inspect": "tsx src/scripts/inspect.ts",
    "preview": "tsx src/scripts/preview.ts",
    "agent": "tsx src/scripts/control.ts",
    "send": "tsx src/scripts/send.ts",
    "queued": "tsx src/scripts/queued.ts",
    "burner": "tsx src/scripts/burner.ts",
    "ig:login": "tsx src/scripts/login.ts",
    "ig:audit": "tsx src/scripts/audit.ts",
    "ig:reply": "tsx src/scripts/reply.ts",
    "ig:thread": "tsx src/scripts/thread.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "next": "^16.2.12",
    "node-cron": "^4.6.0",
    "patchright": "^1.61.1",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
