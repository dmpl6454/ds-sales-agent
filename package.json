{
  "name": "ds-sales-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "worker": "tsx src/worker/index.ts",
    "worker:heartbeat": "tsx src/scripts/heartbeat.ts",
    "agent:device": "tsx src/agent/main.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "run:slot": "tsx src/worker/runOnce.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test": "prisma generate >/dev/null && vitest run; s=$?; bash scripts/prisma-client-for-env.sh; exit $s",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "reclassify": "tsx src/scripts/reclassify.ts",
    "inspect": "tsx src/scripts/inspect.ts",
    "preview": "tsx src/scripts/preview.ts",
    "agent": "tsx src/scripts/control.ts",
    "send": "tsx src/scripts/send.ts",
    "queued": "tsx src/scripts/queued.ts",
    "ig:login": "tsx src/scripts/login.ts",
    "ig:audit": "tsx src/scripts/audit.ts",
    "ig:reply": "tsx src/scripts/reply.ts",
    "ig:thread": "tsx src/scripts/thread.ts",
    "ig:classify": "tsx src/scripts/classify.ts",
    "ig:replies": "tsx src/scripts/replies.ts",
    "ig:accuracy": "tsx src/scripts/accuracy.ts",
