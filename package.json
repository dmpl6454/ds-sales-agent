    "ig:enrich": "tsx src/scripts/enrich.ts",
    "ig:dispatch": "tsx src/scripts/dispatch.ts",
    "ig:dedupe-drafts": "tsx src/scripts/dedupe-drafts.ts",
    "ig:discard-stale-drafts": "tsx src/scripts/discard-stale-drafts.ts",
    "ig:import": "tsx src/scripts/import.ts",
    "ig:prune": "tsx src/scripts/prune.ts",
    "ig:layout": "tsx src/scripts/layout.ts",
    "ig:generate": "tsx src/scripts/generate.ts",
    "ig:detect": "tsx src/scripts/detect.ts",
    "ig:rejudge": "tsx src/scripts/rejudge.ts",
    "ig:rejudge-channel": "tsx src/scripts/rejudgeChannel.ts",
    "ig:second-look": "tsx src/scripts/secondLook.ts",
    "ig:retire-target": "tsx src/scripts/retire-target.ts",
    "ig:ocr": "tsx src/scripts/ocr.ts",
    "ig:frames": "tsx src/scripts/frames.ts",
    "ig:migrate-data": "tsx src/scripts/migrate-data-dir.ts",
    "ig:copy-to-postgres": "tsx src/scripts/copy-to-postgres.ts",
    "db:client": "bash scripts/prisma-client-for-env.sh",
    "local": "bash scripts/local.sh",
    "ig:fix-timestamps": "tsx src/scripts/fix-timestamp-offset.ts",
    "ig:prune-pairs": "tsx src/scripts/prune-pairs.ts",
    "ig:purge-watch-drafts": "tsx src/scripts/purge-watch-drafts.ts",
    "ig:clear-bulk-labels": "tsx src/scripts/clear-bulk-labels.ts",
    "ig:audit-targets": "tsx src/scripts/audit-targets.ts",
